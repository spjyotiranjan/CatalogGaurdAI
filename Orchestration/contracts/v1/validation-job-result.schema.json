{
  "$defs": {
    "AIAdvisoryV1": {
      "additionalProperties": false,
      "properties": {
        "advisoryType": {
          "const": "CATEGORY_CHECK",
          "title": "Advisorytype",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,1}|(?=[\\d.]{1,6}0*$)\\d{0,1}\\.\\d{0,4}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "consistent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consistent"
        },
        "evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Evidence",
          "type": "array"
        },
        "failureReason": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failurereason"
        },
        "inputSnapshotHash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputsnapshothash"
        },
        "latencyMs": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latencyms"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "promptVersion": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promptversion"
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "status": {
          "enum": [
            "COMPLETED",
            "FAILED",
            "SKIPPED"
          ],
          "title": "Status",
          "type": "string"
        },
        "suggestedCategoryId": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestedcategoryid"
        },
        "suggestion": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/AIUsageV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "advisoryType",
        "status"
      ],
      "title": "AIAdvisoryV1",
      "type": "object"
    },
    "AIUsageV1": {
      "additionalProperties": false,
      "properties": {
        "costMicrounits": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Costmicrounits"
        },
        "inputTokens": {
          "minimum": 0,
          "title": "Inputtokens",
          "type": "integer"
        },
        "outputTokens": {
          "minimum": 0,
          "title": "Outputtokens",
          "type": "integer"
        }
      },
      "required": [
        "inputTokens",
        "outputTokens"
      ],
      "title": "AIUsageV1",
      "type": "object"
    },
    "JsonValue": {},
    "NormalizedProductCandidateV1": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 100,
          "title": "Attributes",
          "type": "object"
        },
        "categoryId": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Categoryid"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "externalProductId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Externalproductid",
          "type": "string"
        },
        "listPrice": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,15}|(?=[\\d.]{1,20}0*$)\\d{0,15}\\.\\d{0,4}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Listprice"
        },
        "reservedQuantity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reservedquantity"
        },
        "salePrice": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,15}|(?=[\\d.]{1,20}0*$)\\d{0,15}\\.\\d{0,4}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Saleprice"
        },
        "sku": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sku",
          "type": "string"
        },
        "stockQuantity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stockquantity"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "externalProductId",
        "sku",
        "title"
      ],
      "title": "NormalizedProductCandidateV1",
      "type": "object"
    },
    "RecordValidationResultV1": {
      "additionalProperties": false,
      "properties": {
        "aiAdvisory": {
          "anyOf": [
            {
              "$ref": "#/$defs/AIAdvisoryV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidateIdentity": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Candidateidentity",
          "type": "string"
        },
        "errorSummary": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Errorsummary"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValidationFindingV1"
          },
          "maxItems": 200,
          "title": "Issues",
          "type": "array"
        },
        "normalizedCandidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/NormalizedProductCandidateV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "enum": [
            "ACCEPTED",
            "REJECTED",
            "FAILED"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "ruleSetVersion": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Rulesetversion",
          "type": "string"
        },
        "sourceProductId": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourceproductid"
        },
        "sourceRowNumber": {
          "minimum": 1,
          "title": "Sourcerownumber",
          "type": "integer"
        }
      },
      "required": [
        "sourceRowNumber",
        "candidateIdentity",
        "outcome",
        "ruleSetVersion"
      ],
      "title": "RecordValidationResultV1",
      "type": "object"
    },
    "ResultExecutionMetadata": {
      "additionalProperties": false,
      "properties": {
        "actorService": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Actorservice",
          "type": "string"
        },
        "actorType": {
          "const": "SYSTEM",
          "title": "Actortype",
          "type": "string"
        },
        "correlationId": {
          "format": "uuid",
          "title": "Correlationid",
          "type": "string"
        }
      },
      "required": [
        "correlationId",
        "actorType",
        "actorService"
      ],
      "title": "ResultExecutionMetadata",
      "type": "object"
    },
    "ResultSummaryV1": {
      "additionalProperties": false,
      "properties": {
        "acceptedRows": {
          "minimum": 0,
          "title": "Acceptedrows",
          "type": "integer"
        },
        "processedRows": {
          "minimum": 0,
          "title": "Processedrows",
          "type": "integer"
        },
        "rejectedRows": {
          "minimum": 0,
          "title": "Rejectedrows",
          "type": "integer"
        },
        "totalRows": {
          "minimum": 0,
          "title": "Totalrows",
          "type": "integer"
        }
      },
      "required": [
        "totalRows",
        "processedRows",
        "acceptedRows",
        "rejectedRows"
      ],
      "title": "ResultSummaryV1",
      "type": "object"
    },
    "ValidationFindingV1": {
      "additionalProperties": false,
      "properties": {
        "detectedValue": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expectedValue": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fieldPath": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Fieldpath",
          "type": "string"
        },
        "issueType": {
          "enum": [
            "MISSING",
            "INVALID",
            "INCONSISTENT",
            "DUPLICATE"
          ],
          "title": "Issuetype",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "ruleId": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Ruleid",
          "type": "string"
        },
        "ruleVersion": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Ruleversion",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "BLOCKER"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggestedValue": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "ruleId",
        "ruleVersion",
        "fieldPath",
        "issueType",
        "severity",
        "message"
      ],
      "title": "ValidationFindingV1",
      "type": "object"
    }
  },
  "$id": "https://catalogguard.local/contracts/v1/validation-job-result.schema.json",
  "additionalProperties": false,
  "properties": {
    "checksum": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "contractVersion": {
      "const": "v1",
      "title": "Contractversion",
      "type": "string"
    },
    "execution": {
      "$ref": "#/$defs/ResultExecutionMetadata"
    },
    "feedUploadId": {
      "pattern": "^[a-fA-F0-9]{24}$",
      "title": "Feeduploadid",
      "type": "string"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Idempotencykey",
      "type": "string"
    },
    "jobId": {
      "format": "uuid",
      "title": "Jobid",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/RecordValidationResultV1"
      },
      "maxItems": 1000,
      "title": "Records",
      "type": "array"
    },
    "sellerId": {
      "pattern": "^[a-fA-F0-9]{24}$",
      "title": "Sellerid",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/ResultSummaryV1"
    }
  },
  "required": [
    "contractVersion",
    "jobId",
    "feedUploadId",
    "sellerId",
    "checksum",
    "idempotencyKey",
    "outcome",
    "summary",
    "records",
    "execution"
  ],
  "title": "ValidationJobResultV1",
  "type": "object"
}
