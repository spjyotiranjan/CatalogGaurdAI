CATALOGGUARD_ENVIRONMENT=development
CATALOGGUARD_SERVICE_NAME=catalogguard-orchestration
CATALOGGUARD_SERVICE_VERSION=0.1.0
CATALOGGUARD_LOG_LEVEL=INFO
CATALOGGUARD_OPERATIONAL_DB_PATH=.data/orchestration.db
# Development/test convenience only. Run the migration command separately elsewhere.
CATALOGGUARD_AUTO_MIGRATE_OPERATIONAL_STORE=true
# Real local development and production use an isolated private R2 bucket. Fake storage is test-only.
CATALOGGUARD_PRIVATE_STORAGE_BACKEND=r2
CATALOGGUARD_R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
CATALOGGUARD_R2_BUCKET_NAME=replace-with-local-development-bucket
CATALOGGUARD_R2_ACCESS_KEY_ID=replace-with-read-only-r2-access-key-id
CATALOGGUARD_R2_SECRET_ACCESS_KEY=replace-with-read-only-r2-secret-key
CATALOGGUARD_R2_MAX_OBJECT_BYTES=10485760
CATALOGGUARD_CSV_BATCH_SIZE=100
CATALOGGUARD_WEB_SERVICE_ID=web-bff
CATALOGGUARD_WEB_SERVICE_KEY_VERSION=web-k1
CATALOGGUARD_WEB_SERVICE_SECRET=replace-with-at-least-32-random-characters
CATALOGGUARD_CALLBACK_SERVICE_ID=validation-orchestrator
CATALOGGUARD_CALLBACK_KEY_VERSION=orchestration-k1
CATALOGGUARD_CALLBACK_SIGNING_SECRET=replace-with-a-distinct-32-character-secret
CATALOGGUARD_SERVICE_AUTH_MAX_CLOCK_SKEW_SECONDS=300
CATALOGGUARD_REPLAY_NONCE_RETENTION_SECONDS=900
CATALOGGUARD_MAX_JOB_REQUEST_BYTES=262144
CATALOGGUARD_JOB_TIMEOUT_SECONDS=900
CATALOGGUARD_CALLBACK_TIMEOUT_SECONDS=10
CATALOGGUARD_CALLBACK_MAX_ATTEMPTS=5
CATALOGGUARD_CALLBACK_BACKOFF_BASE_SECONDS=1
CATALOGGUARD_CALLBACK_BACKOFF_MAX_SECONDS=30
# Required as an HTTPS URL in staging and production.
CATALOGGUARD_OTEL_EXPORTER_OTLP_ENDPOINT=
CATALOGGUARD_ENABLE_METRICS=true
# Swagger UI and OpenAPI JSON; set false for production.
CATALOGGUARD_ENABLE_API_DOCS=true
