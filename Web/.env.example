CATALOGGUARD_ENVIRONMENT=development
CATALOGGUARD_SERVICE_NAME=catalogguard-web
CATALOGGUARD_APP_VERSION=0.1.0
MONGODB_URI=mongodb://127.0.0.1:27017/catalogguard?replicaSet=rs0
MONGODB_DB_NAME=catalogguard
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=10
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
SESSION_MAX_AGE_SECONDS=28800
SESSION_UPDATE_AGE_SECONDS=3600
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOG_LEVEL=info
# Swagger UI and OpenAPI JSON; production defaults to false when omitted.
API_DOCS_ENABLED=true
