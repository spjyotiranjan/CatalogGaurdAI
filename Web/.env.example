CATALOGGUARD_ENVIRONMENT=development
CATALOGGUARD_SERVICE_NAME=catalogguard-web
CATALOGGUARD_APP_VERSION=0.1.0
MONGODB_URI=mongodb://127.0.0.1:27017/catalogguard?replicaSet=rs0
MONGODB_DB_NAME=catalogguard
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=10
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
SESSION_MAX_AGE_SECONDS=28800
SESSION_UPDATE_AGE_SECONDS=3600
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOG_LEVEL=info
# Swagger UI and OpenAPI JSON; production defaults to false when omitted.
API_DOCS_ENABLED=true
# Administrator-provisioning secret. Keep unset to disable the endpoint.
BOOTSTRAP_ADMIN_SECRET=replace-with-a-distinct-at-least-32-random-character-secret
# Phase 1 Web <-> Orchestration bridge. Values must match Orchestration/fastapi/.env.
ORCHESTRATION_BASE_URL=http://localhost:8000
ORCHESTRATION_WEB_SERVICE_ID=web-bff
ORCHESTRATION_WEB_SERVICE_KEY_VERSION=web-k1
ORCHESTRATION_WEB_SERVICE_SECRET=replace-with-at-least-32-random-characters
ORCHESTRATION_CALLBACK_SERVICE_ID=validation-orchestrator
ORCHESTRATION_CALLBACK_KEY_VERSION=orchestration-k1
ORCHESTRATION_CALLBACK_SIGNING_SECRET=replace-with-a-distinct-at-least-32-random-characters
ORCHESTRATION_SERVICE_AUTH_MAX_CLOCK_SKEW_SECONDS=300
ORCHESTRATION_REPLAY_NONCE_RETENTION_SECONDS=900
# Phase 2 private Cloudflare R2 feed storage. Never expose these as NEXT_PUBLIC_* values.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=replace-with-local-development-bucket
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_MAX_UPLOAD_BYTES=10485760
R2_DOWNLOAD_URL_TTL_SECONDS=300
